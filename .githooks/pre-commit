#!/usr/bin/env node
const path = require('node:path');
const { spawnSync } = require('node:child_process');
const result = spawnSync(process.execPath, [path.join(__dirname, '..', 'tools', 'update-page-dates.cjs'), '--staged'], { stdio: 'inherit' });
if (result.error) {
    console.error(result.error);
    process.exit(1);
}
process.exit(result.status === null ? 1 : result.status);
